{
  "name": "หมีจด MheeJod",
  "short_name": "หมีจด",
  "description": "จดรายรับ-รายจ่ายง่าย ๆ พิมพ์ พูด หรือถ่ายสลิปก็จดได้",
  "lang": "th",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FFF8F0",
  "theme_color": "#F2B23E",
  "categories": ["finance", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "file", "accept": ["image/*"] }]
    }
  },
  "shortcuts": [
    { "name": "จดรายการใหม่", "short_name": "จด", "url": "./#add" },
    { "name": "ถ่ายสลิป", "short_name": "สลิป", "url": "./#add" },
    { "name": "ดูรายการ", "short_name": "รายการ", "url": "./#transactions" }
  ]
}
